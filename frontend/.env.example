# Copy to .env.local and fill. .env.local is gitignored.

# Public app URL — injected into the Mini App manifest + embed meta at build
# (vite.config.ts). Auto-detected on Vercel / Netlify; set it for other hosts.
# e.g. VITE_APP_URL=https://diamond-hands.vercel.app
VITE_APP_URL=

# Target network. Leave unset for Base mainnet (default). Set to 1 for the
# testnet build (Base Sepolia). All chain-specific defaults (factory, WETH,
# explorer) switch with this flag — set it once, the rest follows.
VITE_USE_TESTNET=

# DiamondHandsFactory address — the ACTIVE factory (new vaults are created
# here). Defaults are baked in per network in src/web3/contracts.ts; only
# set this to override (e.g. a mainnet v2 redeploy).
VITE_FACTORY_ADDRESS=

# Optional: previous factory deployments (comma-separated). Vaults created
# there stay visible on the dashboard. Defaults are baked in per network.
VITE_LEGACY_FACTORY_ADDRESSES=

# RPC URL. Optional — defaults to the chain's public RPC. A private RPC
# (Alchemy / Infura / QuickNode) is more reliable and supports eth_getLogs.
# Mainnet:
VITE_BASE_RPC_URL=
# Testnet (also read as a fallback for the mainnet var, for compatibility):
VITE_BASE_SEPOLIA_RPC_URL=

# Optional: OnchainKit / MiniKit API key (Coinbase Developer Platform).
VITE_ONCHAINKIT_API_KEY=

# Optional: a test ERC-20 (e.g. DHT from contracts/script/DeployMockToken).
# When set, it appears (as "DHT") in the create-flow token picker in live mode.
VITE_TEST_TOKEN_ADDRESS=
