# Copy to .env.local and fill. .env.local is gitignored.

# Public app URL — injected into the Mini App manifest + embed meta at build
# (vite.config.ts). Auto-detected on Vercel / Netlify; set it for other hosts.
# e.g. VITE_APP_URL=https://diamond-hands.vercel.app
VITE_APP_URL=

# DiamondHandsFactory address on Base Sepolia (see docs/deploy.md).
VITE_FACTORY_ADDRESS=0x89de426deF37Aa34c17f72d6a73229E64dd93e11

# Chain id (Base Sepolia).
VITE_CHAIN_ID=84532

# RPC URL. Optional — defaults to the chain's public RPC. A private RPC
# (Alchemy / Infura / QuickNode) is more reliable.
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: OnchainKit / MiniKit API key (Coinbase Developer Platform).
VITE_ONCHAINKIT_API_KEY=

# Optional: a test ERC-20 (e.g. DHT from contracts/script/DeployMockToken).
# When set, it appears (as "DHT") in the create-flow token picker in live mode.
VITE_TEST_TOKEN_ADDRESS=
