# ---------------------------------------------------------------------
# Скопируй в contracts/.env и заполни. .env в .gitignore — не коммить.
# ---------------------------------------------------------------------

# ОБЯЗАТЕЛЬНО: получатель penalty при emergencyWithdraw.
# Это ПУБЛИЧНЫЙ адрес, не секрет. На тестнете можно = адрес deployer'а.
FEE_RECEIVER=0xYOUR_FEE_RECEIVER_ADDRESS

# RPC-эндпоинты. Дефолты публичные; для надёжности можно подставить
# приватный (Alchemy / Infura / QuickNode).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# ОПЦИОНАЛЬНО: ключ BaseScan для верификации исходников (--verify).
# Это API-токен, не кошелёк. Бесплатно на basescan.org.
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY

# ---------------------------------------------------------------------
# ПОДПИСАНТ (deployer) НЕ ХРАНИТСЯ ЗДЕСЬ.
# Рекомендуется зашифрованный keystore: `cast wallet import` →
# деплой с `--account <name>` (форж спросит пароль).
# Сырой PRIVATE_KEY в .env — только запасной путь для тестнета.
# Если используешь его, раскомментируй и передавай на CLI как
# `--private-key $PRIVATE_KEY`:
# PRIVATE_KEY=0xYOUR_THROWAWAY_TESTNET_KEY
# ---------------------------------------------------------------------
