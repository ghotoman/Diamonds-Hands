# Copy to .env (gitignored) or set as CI secrets. Required: BASE_RPC_URL,
# FACTORY_ADDRESSES. The rest have sensible defaults.

# Base mainnet RPC. A private endpoint (Alchemy / Infura / QuickNode) is
# strongly recommended — eth_getLogs on public RPCs is rate-limited.
BASE_RPC_URL=https://mainnet.base.org

# Comma-separated factory address(es) to scan. Include legacy factories so
# their still-live vaults count toward TVL.
FACTORY_ADDRESSES=0xYourMainnetFactory

# Block the EARLIEST factory was deployed at — bounds the log scan. Find it on
# BaseScan (the factory's contract-creation block). Scanning from 0 is slow.
START_BLOCK=0

# eth_getLogs range chunk. Lower it if your RPC rejects wide ranges.
LOG_STEP=50000

# The soft-launch cap (USD) and the early-warning ratio (0.8 = warn at 80%).
THRESHOLD_USD=1000000
WARN_RATIO=0.8

# Optional: POST the JSON report here on WARN/CRITICAL. Works with any webhook
# (Slack / Discord / Telegram bridge). Unset → console + exit code only.
ALERT_WEBHOOK_URL=

# Optional: override the price API (default DefiLlama, free, no key).
PRICE_API=https://coins.llama.fi
